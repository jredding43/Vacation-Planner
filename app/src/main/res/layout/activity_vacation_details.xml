<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/textViewVacationName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Vacation Name"
            android:textSize="28sp"
            android:textColor="@color/colorPrimary"
            android:layout_marginBottom="20dp"
            android:textStyle="bold" />

        <!-- Card for Flight and Dates Information -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardElevation="6dp"
            app:cardCornerRadius="10dp"
            android:backgroundTint="@color/colorLightGray">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textViewToFlight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="To Flight: "
                    android:textSize="20sp"
                    android:textColor="@color/colorDarkGray"
                    android:layout_marginBottom="10dp" />

                <TextView
                    android:id="@+id/textViewFromFlight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="From Flight: "
                    android:textSize="20sp"
                    android:textColor="@color/colorDarkGray"
                    android:layout_marginBottom="10dp" />

                <TextView
                    android:id="@+id/textViewDepartDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Departure Date: "
                    android:textSize="20sp"
                    android:textColor="@color/colorDarkGray"
                    android:layout_marginBottom="10dp" />

                <TextView
                    android:id="@+id/textViewReturnDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Return Date: "
                    android:textSize="20sp"
                    android:textColor="@color/colorDarkGray"
                    android:layout_marginBottom="10dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Card for Number of Adults/Kids and Hotel -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardElevation="6dp"
            app:cardCornerRadius="10dp"
            android:backgroundTint="@color/colorLightGray">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textViewAdults"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Number of Adults: "
                    android:textSize="20sp"
                    android:textColor="@color/colorDarkGray"
                    android:layout_marginBottom="10dp" />

                <TextView
                    android:id="@+id/textViewKids"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Number of Kids: "
                    android:textSize="20sp"
                    android:textColor="@color/colorDarkGray"
                    android:layout_marginBottom="10dp" />

                <TextView
                    android:id="@+id/textViewHotel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Hotel: "
                    android:textSize="20sp"
                    android:textColor="@color/colorDarkGray"
                    android:layout_marginBottom="10dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Action Buttons -->
        <Button
            android:id="@+id/buttonSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:backgroundTint="@color/colorAccent"
            android:padding="16dp"
            android:text="Save Without Excursions"
            android:textColor="@android:color/white"
            android:textSize="18sp" />

        <Button
            android:id="@+id/buttonViewExcursionDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:backgroundTint="@color/colorAccent"
            android:padding="16dp"
            android:text="Add Excursion To Vacation"
            android:textColor="@android:color/white"
            android:textSize="18sp" />

        <Button
            android:id="@+id/buttonShare"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Share Vacation"
            android:backgroundTint="@color/colorAccent"
            android:textColor="@android:color/white"
            android:padding="16dp"
            android:textSize="18sp"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/buttonEdit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:backgroundTint="@color/colorAccent"
            android:padding="16dp"
            android:text="Edit Vacation"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:visibility="visible" />

        <Button
            android:id="@+id/buttonDelete"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:backgroundTint="@color/colorRed"
            android:padding="16dp"
            android:text="Delete Vacation"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>

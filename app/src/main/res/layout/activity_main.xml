<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="@color/colorBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center">

        <!-- Title or Welcome Message -->
        <TextView
            android:id="@+id/welcomeMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Welcome Back!"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/colorPrimary"
            android:layout_marginBottom="24dp"
            android:gravity="center"/>

        <!-- User Account Display (Optional: Add profile picture) -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardElevation="4dp"
            app:cardCornerRadius="12dp"
            app:cardBackgroundColor="@color/colorCardBackground">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp"
                android:gravity="center">

                <TextView
                    android:id="@+id/textViewUserEmail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Logged in as: john.doe@example.com"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorTextPrimary"
                    android:layout_marginBottom="16dp"
                    android:gravity="center"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Button to go to Vacation -->
        <Button
            android:id="@+id/buttonToVacation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Go to Vacation"
            android:backgroundTint="@color/colorAccent"
            android:textColor="@android:color/white"
            android:padding="16dp"
            android:textSize="18sp"
            android:layout_marginBottom="16dp"
            android:layout_gravity="center"
            android:layout_marginTop="16dp"
            android:background="@drawable/rounded_button"/>

        <!-- Button to go to Vacation List -->
        <Button
            android:id="@+id/buttonToVacationList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Go to Vacation List"
            android:backgroundTint="@color/colorAccent"
            android:textColor="@android:color/white"
            android:padding="16dp"
            android:textSize="18sp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/rounded_button"/>

        <!-- Button to generate the report -->
        <Button
            android:id="@+id/buttonGenerateReport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Generate Report"
            android:backgroundTint="@color/colorAccent"
            android:textColor="@android:color/white"
            android:padding="16dp"
            android:textSize="18sp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/rounded_button"/>

    </LinearLayout>
</ScrollView>
